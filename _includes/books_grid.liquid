{% comment %}
  Book grid for /ml_resources/, rendered from _data/ml_resources_books.yml.
  Styles live in _sass/_ml_resources.scss.
{% endcomment %}
{% assign filter_tags = 'Deep Learning,Machine Learning,Math,NLP,Computer Vision,Reinforcement Learning,Statistics' | split: ',' %}

<div class="res-books-search">
  <input type="search" id="bookSearch" placeholder="Search books..." aria-label="Search books">
  <div class="res-filter-tags" id="bookTags">
    <button type="button" class="active" data-tag="">All</button>
    {% for tag in filter_tags %}
      <button type="button" data-tag="{{ tag | downcase }}">{{ tag }}</button>
    {% endfor %}
  </div>
</div>

<div class="res-grid" id="booksGrid">
  {% assign books = site.data.ml_resources_books | sort: 'print_year' | reverse %}
  {% for book in books %}
    {% capture search_text %}{{ book.title }} {{ book.book_author }} {{ book.tags | join: ' ' }}{% endcapture %}
    <div
      class="res-book"
      data-text="{{ search_text | downcase | escape }}"
      data-tags="|{{ book.tags | join: '|' | downcase | escape }}|"
    >
      <div class="res-book-cover">
        {% if book.front_page %}
          <img src="{{ book.front_page }}" alt="{{ book.title | escape }}" loading="lazy" onerror="this.hidden = true; this.nextElementSibling.hidden = false">
          <span hidden>No Cover</span>
        {% else %}
          <span>No Cover</span>
        {% endif %}
      </div>

      <div class="res-book-body">
        <h5>{{ book.title }}</h5>
        {% if book.book_author %}
          <div class="res-book-meta res-book-author"><i class="fa-solid fa-user-pen"></i> {{ book.book_author }}</div>
        {% endif %}
        <div class="res-book-meta">
          {% if book.print_year %}<span><i class="fa-regular fa-calendar"></i> {{ book.print_year }}</span>{% endif %}
          {% if book.publisher %}<span><i class="fa-solid fa-building"></i> {{ book.publisher }}</span>{% endif %}
        </div>
        <div class="res-book-tags">
          {% for tag in book.tags limit: 3 %}<span>{{ tag }}</span>{% endfor %}
        </div>

        <div class="res-book-actions">
          {% if book.description %}
            <button type="button" class="res-btn" data-action="description" data-title="{{ book.title | escape }}" data-description="{{ book.description | escape }}">Desc.</button>
          {% endif %}
          <a href="{{ book.book_url }}" class="res-btn" target="_blank" rel="noopener noreferrer">Website</a>
          {% if book.supp_material %}
            <button type="button" class="res-btn" data-action="materials">More</button>
          {% endif %}
        </div>

        {% if book.supp_material %}
          <div class="res-materials" hidden>
            Supplementary materials:
            <ul>
              {% for material in book.supp_material %}
                <li><a href="{{ material }}" target="_blank" rel="noopener noreferrer">Material {{ forloop.index }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

<p class="res-no-results" id="booksEmpty" hidden>No books found.</p>

<dialog class="res-dialog" id="bookDialog" aria-labelledby="bookDialogTitle">
  <header>
    <h5 id="bookDialogTitle"></h5>
    <button type="button" aria-label="Close" data-action="close">&times;</button>
  </header>
  <p id="bookDialogBody"></p>
</dialog>

<script>
  (() => {
    const search = document.getElementById('bookSearch');
    const tagButtons = document.querySelectorAll('#bookTags button');
    const books = document.querySelectorAll('#booksGrid .res-book');
    const empty = document.getElementById('booksEmpty');
    const dialog = document.getElementById('bookDialog');
    let activeTag = '';

    // A book is shown if it has the selected tag (exact match) and contains the search text.
    function filterBooks() {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      books.forEach((book) => {
        const show = (!activeTag || book.dataset.tags.includes(`|${activeTag}|`)) && book.dataset.text.includes(query);
        book.hidden = !show;
        if (show) visible++;
      });
      empty.hidden = visible > 0;
    }

    search.addEventListener('input', filterBooks);

    tagButtons.forEach((button) =>
      button.addEventListener('click', () => {
        tagButtons.forEach((b) => b.classList.toggle('active', b === button));
        activeTag = button.dataset.tag;
        filterBooks();
      })
    );

    document.getElementById('booksGrid').addEventListener('click', (e) => {
      const button = e.target.closest('[data-action]');
      if (button?.dataset.action === 'description') {
        dialog.querySelector('#bookDialogTitle').textContent = button.dataset.title;
        dialog.querySelector('#bookDialogBody').textContent = button.dataset.description;
        dialog.showModal();
      } else if (button?.dataset.action === 'materials') {
        const materials = button.closest('.res-book-body').querySelector('.res-materials');
        materials.hidden = !materials.hidden;
        button.classList.toggle('active', !materials.hidden);
      }
    });

    // Close on the × button or a click on the backdrop.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target.closest('[data-action="close"]')) dialog.close();
    });
  })();
</script>
