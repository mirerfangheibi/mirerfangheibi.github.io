{% comment %}
  Book grid for /ml_resources/, rendered from _data/ml_resources_books.yml.
  Search and tag filtering are done by resources_filter.liquid (data-res-list / data-text /
  data-tags / data-count / data-empty). Styles live in _sass/_ml_resources.scss.
{% endcomment %}
<div class="res-toolbar">
  <span>Showing <b data-count="Books">{{ site.data.ml_resources_books | size }}</b> of {{ site.data.ml_resources_books | size }}</span>
  <div class="res-view-toggle" role="group" aria-label="Layout">
    <button type="button" data-view="grid" aria-pressed="true" title="Grid"><i class="fa-solid fa-table-cells-large"></i> Grid</button>
    <button type="button" data-view="list" aria-pressed="false" title="List"><i class="fa-solid fa-list"></i> List</button>
  </div>
</div>

<div class="res-grid" id="booksGrid" data-res-list="Books">
  {% assign books = site.data.ml_resources_books | sort: 'print_year' | reverse %}
  {% for book in books %}
    {% capture search_text %}{{ book.title }} {{ book.book_author }} {{ book.tags | join: ' ' }} {{ book.description }}{% endcapture %}
    <div
      class="res-book"
      data-text="{{ search_text | downcase | escape }}"
      data-tags="|{{ book.tags | join: '|' | downcase | escape }}|"
    >
      <div class="res-book-cover">
        {% if book.front_page %}
          <img src="{{ book.front_page | escape }}" alt="{{ book.title | escape }}" loading="lazy" onerror="this.hidden = true; this.nextElementSibling.hidden = false">
          <span hidden>No Cover</span>
        {% else %}
          <span>No Cover</span>
        {% endif %}
      </div>

      <div class="res-book-body">
        <h5>{{ book.title }}</h5>
        {% if book.book_author %}
          <div class="res-book-meta res-book-author"><i class="fa-solid fa-user-pen"></i> {{ book.book_author }}</div>
        {% endif %}
        <div class="res-book-meta">
          {% if book.print_year %}<span><i class="fa-regular fa-calendar"></i> {{ book.print_year }}</span>{% endif %}
          {% if book.publisher %}<span><i class="fa-solid fa-building"></i> {{ book.publisher }}</span>{% endif %}
        </div>
        <div class="res-book-footer">
          <div class="res-book-tags">
            {% for tag in book.tags limit: 3 %}<span>{{ tag }}</span>{% endfor %}
          </div>
          <div class="res-book-actions">
            {% if book.description %}
              <button type="button" class="res-btn" data-action="description" data-title="{{ book.title | escape }}" data-description="{{ book.description | escape }}">Desc.</button>
            {% endif %}
            <a href="{{ book.book_url | escape }}" class="res-btn" target="_blank" rel="noopener noreferrer">Website</a>
            {% if book.supp_material %}
              <button type="button" class="res-btn" data-action="materials">More</button>
            {% endif %}
          </div>
        </div>

        {% if book.supp_material %}
          <div class="res-materials" hidden>
            Supplementary materials:
            <ul>
              {% for material in book.supp_material %}
                <li><a href="{{ material | escape }}" target="_blank" rel="noopener noreferrer">Material {{ forloop.index }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

<p class="res-no-results" data-empty="Books" hidden>No books found.</p>

<dialog class="res-dialog" id="bookDialog" aria-labelledby="bookDialogTitle">
  <header>
    <h5 id="bookDialogTitle"></h5>
    <button type="button" aria-label="Close" data-action="close">&times;</button>
  </header>
  <p id="bookDialogBody"></p>
</dialog>

<script>
  (() => {
    const grid = document.getElementById('booksGrid');
    const dialog = document.getElementById('bookDialog');
    const viewButtons = document.querySelectorAll('.res-view-toggle button');

    // Grid/list layout; the list view is the `res-list` class (safelisted in purgecss.config.js).
    function setView(view) {
      grid.classList.toggle('res-list', view === 'list');
      viewButtons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.view === view));
      try {
        localStorage.setItem('mlResourcesView', view);
      } catch (e) {}
    }
    viewButtons.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));
    try {
      if (localStorage.getItem('mlResourcesView') === 'list') setView('list');
    } catch (e) {}

    grid.addEventListener('click', (e) => {
      const button = e.target.closest('[data-action]');
      if (button?.dataset.action === 'description') {
        dialog.querySelector('#bookDialogTitle').textContent = button.dataset.title;
        dialog.querySelector('#bookDialogBody').textContent = button.dataset.description;
        dialog.showModal();
      } else if (button?.dataset.action === 'materials') {
        const materials = button.closest('.res-book-body').querySelector('.res-materials');
        materials.hidden = !materials.hidden;
        button.classList.toggle('active', !materials.hidden);
      }
    });

    // Close on the × button or a click on the backdrop.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target.closest('[data-action="close"]')) dialog.close();
    });
  })();
</script>
