{% comment %}
  Course grid for /ml_resources/, rendered from _data/ml_resources_courses.yml.
  Styles live in _sass/_ml_resources.scss.
{% endcomment %}
<div class="res-grid">
  {% assign courses = site.data.ml_resources_courses | sort: 'year' | reverse %}
  {% for course in courses %}
    <div class="res-course">
      <h5>{{ course.title }}</h5>
      <ul>
        {% if course.instructor %}<li><b>Instructor(s):</b> {{ course.instructor }}</li>{% endif %}
        {% if course.year %}<li><b>Year:</b> {{ course.year }}</li>{% endif %}
        {% if course.institute %}<li><b>Institute:</b> {{ course.institute }}</li>{% endif %}
      </ul>
      {% if course.description %}
        <details>
          <summary>Description</summary>
          <p>{{ course.description }}</p>
        </details>
      {% endif %}
      {% if course.personal_notes %}
        <details>
          <summary>Personal Notes</summary>
          <p>{{ course.personal_notes }}</p>
        </details>
      {% endif %}
      <div class="res-course-links">
        {% if course.course_url %}<a class="res-btn" href="{{ course.course_url }}">Course Website</a>{% endif %}
        {% if course.lecture_videos %}<a class="res-btn" href="{{ course.lecture_videos }}">Lecture Videos</a>{% endif %}
        {% if course.lecture_notes %}<a class="res-btn" href="{{ course.lecture_notes }}">Lecture Notes</a>{% endif %}
        {% for material in course.supp_material %}
          <a class="res-btn" href="{{ material }}">Supp. Material {{ forloop.index }}</a>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
