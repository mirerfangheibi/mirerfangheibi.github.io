<style>
  .res-courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .res-course-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--global-divider-color);
    border-radius: 4px;
    background-color: var(--global-card-bg-color);
    color: var(--global-text-color);
  }

  .res-course-title {
    margin: 0;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 500;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.075);
  }

  .res-course-info {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .res-course-info li {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    border-top: 1px solid var(--global-divider-color);
  }

  .res-course-details {
    border-top: 1px solid var(--global-divider-color);
    font-size: 0.875rem;
  }

  .res-course-details summary {
    padding: 0.5rem 1rem;
    cursor: pointer;
    color: var(--global-theme-color);
  }

  .res-course-details p {
    margin: 0;
    padding: 0 10px 10px;
    text-align: justify;
  }

  .res-course-links {
    margin-top: auto;
    padding: 1rem;
    border-top: 1px solid var(--global-divider-color);
  }

  .res-course-links a {
    display: inline-block;
    margin: 0 2px 4px 0;
    padding: 0.25rem 1rem;
    border: 1px solid var(--global-text-color);
    border-radius: 4px;
    font-size: 0.8rem;
    color: var(--global-text-color);
    text-decoration: none;
  }

  .res-course-links a:hover {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
  }
</style>

<div class="res-courses-grid">
  {% assign scourses = site.data.ml_resources_courses | sort: 'year' | reverse %}
  {% for course in scourses %}
    <div class="res-course-card">
      <h5 class="res-course-title">{{ course.title }}</h5>

      <ul class="res-course-info">
        {% if course.instructor %}
          <li><b>Instructor(s):</b> {{ course.instructor }}</li>
        {% endif %}
        {% if course.year %}
          <li><b>Year:</b> {{ course.year }}</li>
        {% endif %}
        {% if course.institute %}
          <li><b>Institute:</b> {{ course.institute }}</li>
        {% endif %}
      </ul>

      {% if course.description %}
        <details class="res-course-details">
          <summary>Description</summary>
          <p>{{ course.description }}</p>
        </details>
      {% endif %}

      {% if course.personal_notes %}
        <details class="res-course-details">
          <summary>Personal Notes</summary>
          <p>{{ course.personal_notes }}</p>
        </details>
      {% endif %}

      <div class="res-course-links">
        {% if course.course_url %}
          <a href="{{ course.course_url }}">Course Website</a>
        {% endif %}
        {% if course.lecture_videos %}
          <a href="{{ course.lecture_videos }}">Lecture Videos</a>
        {% endif %}
        {% if course.lecture_notes %}
          <a href="{{ course.lecture_notes }}">Lecture Notes</a>
        {% endif %}
        {% for material in course.supp_material %}
          <a href="{{ material }}">Supp. Material {{ forloop.index }}</a>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
