{% comment %}
  Course list for /ml_resources/, rendered from _data/ml_resources_courses.yml.
  course.video (thumbnail, title, channel) is added at build time by _plugins/youtube_oembed.rb.
  Search and tag filtering are done by resources_filter.liquid (data-res-list / data-text /
  data-tags / data-count / data-empty). Styles live in _sass/_ml_resources.scss.
{% endcomment %}
<div class="res-courses" data-res-list="Courses">
  {% assign courses = site.data.ml_resources_courses | sort: 'year' | reverse %}
  {% for course in courses %}
    {% capture search_text %}{{ course.title }} {{ course.instructor }} {{ course.institute }} {{ course.tags | join: ' ' }} {{ course.description }} {{ course.video.title }} {{ course.video.channel }}{% endcapture %}
    <div
      class="res-course"
      data-text="{{ search_text | downcase | escape }}"
      data-tags="|{{ course.tags | join: '|' | downcase | escape }}|"
    >
      {% if course.video.thumbnail %}
        <a class="res-course-thumb" href="{{ course.lecture_videos | escape }}" target="_blank" rel="noopener noreferrer" title="{{ course.video.title | escape }}">
          <img src="{{ course.video.thumbnail | escape }}" alt="{{ course.video.title | escape }}" loading="lazy">
          <span aria-hidden="true"><i class="fa-solid fa-play"></i></span>
        </a>
      {% else %}
        <div class="res-course-thumb res-course-thumb-empty" aria-hidden="true"><i class="fa-solid fa-graduation-cap"></i></div>
      {% endif %}

      <div class="res-course-body">
        <h5>{{ course.title }}</h5>
        {% assign meta = '' | split: '' %}
        {% if course.instructor %}{% assign meta = meta | push: course.instructor %}{% endif %}
        {% if course.institute %}{% assign meta = meta | push: course.institute %}{% endif %}
        {% if course.year %}{% assign meta = meta | push: course.year %}{% endif %}
        <div class="res-course-meta">{{ meta | join: ' · ' }}</div>
        {% if course.tags %}
          <div class="res-book-tags res-course-tags">
            {% for tag in course.tags %}<span>{{ tag }}</span>{% endfor %}
          </div>
        {% endif %}

        {% if course.description %}
          <details>
            <summary>Description</summary>
            <p>{{ course.description }}</p>
          </details>
        {% endif %}
        {% if course.personal_notes %}
          <details>
            <summary>Personal Notes</summary>
            <p>{{ course.personal_notes }}</p>
          </details>
        {% endif %}

        <div class="res-course-links">
          {% if course.course_url %}<a class="res-btn" href="{{ course.course_url | escape }}">Course Website</a>{% endif %}
          {% if course.lecture_videos %}<a class="res-btn" href="{{ course.lecture_videos | escape }}">Lecture Videos</a>{% endif %}
          {% if course.lecture_notes %}<a class="res-btn" href="{{ course.lecture_notes | escape }}">Lecture Notes</a>{% endif %}
          {% for material in course.supp_material %}
            <a class="res-btn" href="{{ material | escape }}">Supp. Material {{ forloop.index }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<p class="res-no-results" data-empty="Courses" hidden>No courses found.</p>
